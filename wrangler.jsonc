{
  "name": "threefetyayouth-api",
  "main": "worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "rm -f bunfig.toml bun.lock bun.lockb && npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME_ROOM",
        "class_name": "RealtimeRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RealtimeRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "threefetyayouth",
      "database_id": "1d13778e-f840-482d-b1e9-02dda36fc9e3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "threefetyayouth-media"
    }
  ]
,
"kv_namespaces": [
  {
    "binding": "MEMBERS_KV",
    "id": "ddc65a98eb3b406bb292145b9bbe3613"
  }
]
}
