{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/|OneSignalSDKWorker\\.js|OneSignalSDKUpdaterWorker\\.js|manifest\\.json|favicon|apple-touch-icon|pwa-icon|site-logo|notif-logo|notif-empty|site-badge|assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/OneSignalSDKWorker.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/OneSignalSDKUpdaterWorker.js",
      "headers": [
        { "key": "Service-Worker-Allowed", "value": "/" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
